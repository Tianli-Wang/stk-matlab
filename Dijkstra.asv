% =========================================================================
% 卫星网络最短路径规划 (Dijkstra 算法) - 3D 交互版
% =========================================================================

clear; clc; close all;

%% 1. 配置参数
% 输入文件
csv_filename = 'Visibility_Results_Step5s_Limit500km/visibility_step0001_27_Feb_2025_00_00_00_000000000.csv'; 

% 定义起点和终点卫星名称
startSatName = 'STARLINK_1437';   % 起点卫星
endSatName   = 'STARLINK_1566';  % 终点卫星

%% 2. 加载数据与构建图
fprintf('正在读取网络拓扑数据: %s ...\n', csv_filename);

if ~isfile(csv_filename)
    error('未找到文件 %s。\n请先运行之前的步骤生成数据。', csv_filename);
end

linkData = readtable(csv_filename);

if isempty(linkData)
    error('CSV 文件为空，没有可用的连接。');
end

% 构建无向图
G = graph(linkData.Sat1, linkData.Sat2, linkData.Distance_km);

fprintf('网络构建完成。\n节点数: %d | 边数: %d\n', numnodes(G), numedges(G));

%% 3. 检查节点是否存在
if findnode(G, startSatName) == 0 || findnode(G, endSatName) == 0
    error('起点或终点卫星不在网络拓扑中。');
end

%% 4. 执行最短路径算法 (Dijkstra)
fprintf('\n正在计算从 %s 到 %s 的最短路径...\n', startSatName, endSatName);
[pathNodes, pathDist, edgeIndices] = shortestpath(G, startSatName, endSatName, 'Method', 'positive');

%% 5. 输出结果文本
if isempty(pathNodes)
    fprintf('警告: 无法到达！\n');
else
    fprintf('--------------------------------------------------\n');
    fprintf('总距离: %.3f km\n', pathDist);
    fprintf('跳数: %d 跳\n', length(pathNodes)-1);
    fprintf('--------------------------------------------------\n');
end

%% 6. 三维可视化网络拓扑与路径 (核心修改部分)
fprintf('正在生成三维交互图...\n');

% 创建黑色背景的图形窗口，更有“太空感”
fig = figure('Color', 'k', 'Name', '3D Satellite Network Routing');

% 使用 'force3' 布局生成三维坐标
% Iterations 设大一点可以让节点分布得更均匀
p = plot(G, 'Layout', 'force3', 'Iterations', 50); 

% === 样式美化 ===
% 1. 设置非路径节点和边的样式（暗淡一点，作为背景）
p.NodeColor = [0.6 0.6 0.6];       % 灰色节点
p.MarkerSize = 4;                  % 节点大小
p.EdgeColor = [0.3 0.3 0.3];       % 深灰色连线
p.EdgeAlpha = 0.3;                 % 连线半透明，防止太乱
p.NodeLabel = {};                  % 默认不显示任何标签

% 2. 坐标轴与背景设置
axis equal;           % 等比例显示
axis vis3d;           % 旋转时保持比例
view(3);              % 切换到 3D 视角
grid on;              % 显示网格
set(gca, 'Color', 'k');            % 坐标轴背景黑色
set(gca, 'XColor', 'w', 'YColor', 'w', 'ZColor', 'w'); % 坐标轴文字白色
xlabel('Topology X'); ylabel('Topology Y'); zlabel('Topology Z');

title({'卫星网络三维路由规划', ...
       sprintf('\\color{yellow}%s \\color{white}-> \\color{cyan}%s \\color{white}(%.0f km)', ...
       startSatName, endSatName, pathDist)}, ...
       'Color', 'w', 'FontSize', 12);

% === 路径高亮 ===
if ~isempty(pathNodes)
    % 高亮路径连线 (红色, 加粗)
    highlight(p, 'Edges', edgeIndices, 'EdgeColor', 'r', 'LineWidth', 3, 'EdgeAlpha', 1);
    
    % 高亮路径节点 (红色)
    highlight(p, pathNodes, 'NodeColor', 'r', 'MarkerSize', 7);
    
    % 特别标记起点 (绿色, 大球)
    highlight(p, startSatName, 'NodeColor', 'g', 'MarkerSize', 12);
    
    % 特别标记终点 (青色, 大球)
    highlight(p, endSatName, 'NodeColor', 'c', 'MarkerSize', 12);
    
    % 只显示路径上的卫星名称
    labelNodes = pathNodes;
    idx = findnode(G, labelNodes);
    p.NodeLabel(idx) = labelNodes;
    
    % 尝试调整标签字体 (仅对支持的 MATLAB 版本有效)
    try
        p.NodeFontSize = 10;
        p.NodeFontColor = 'w'; % 白色字体
    catch
    end
end

% === 开启交互功能 ===
rotate3d on; % 默认开启旋转模式，直接用鼠标拖动即可

% 提示用户
msgbox('图表生成完毕！请使用鼠标拖动旋转视图，滚动滚轮缩放。', '交互提示');
fprintf('可视化完成。请在弹出的窗口中用鼠标操作。\n');